																	"maxclass" : "comment",
																	"numinlets" : 1,
																	"numoutlets" : 0,
																	"patching_rect" : [ 424.0, 344.0, 40.0, 19.0 ],
																	"text" : "-jhno"
																}

															}
, 															{
																"box" : 																{
																	"fontname" : "Arial",
																	"fontsize" : 11.0,
																	"id" : "obj-2",
																	"maxclass" : "comment",
																	"numinlets" : 1,
																	"numoutlets" : 0,
																	"patching_rect" : [ 16.0, 320.0, 344.0, 19.0 ],
																	"text" : "Search the web for more info on cellular, if interested. it is fascinating"
																}

															}
, 															{
																"box" : 																{
																	"fontname" : "Arial",
																	"fontsize" : 11.0,
																	"id" : "obj-3",
																	"linecount" : 2,
																	"maxclass" : "comment",
																	"numinlets" : 1,
																	"numoutlets" : 0,
																	"patching_rect" : [ 16.0, 280.0, 520.0, 31.0 ],
																	"text" : "For a program using scott draves' excellent cellular graphics program, \"bomb\". can download bomb from http://www.cs.cmu.edu/~spot/bomb.html. It is my all-time favorite work of computer graphics art."
																}

															}
, 															{
																"box" : 																{
																	"fontname" : "Arial",
																	"fontsize" : 11.0,
																	"id" : "obj-4",
																	"linecount" : 3,
																	"maxclass" : "comment",
																	"numinlets" : 1,
																	"numoutlets" : 0,
																	"patching_rect" : [ 16.0, 184.0, 432.0, 43.0 ],
																	"text" : "If having performance problems, such as clicks in the audio output, try clicking on the \"config audio\" button and reducing the sample rate, or increasing the vector sizes. Also, can turn off cells by the \"mute cell groups\" checkboxes. This will conserve CPU."
																}

															}
, 															{
																"box" : 																{
																	"fontname" : "Arial",
																	"fontsize" : 11.0,
																	"id" : "obj-5",
																	"linecount" : 2,
																	"maxclass" : "comment",
																	"numinlets" : 1,
																	"numoutlets" : 0,
																	"patching_rect" : [ 16.0, 144.0, 444.0, 31.0 ],
																	"text" : "The sliders represent the frequencies of the sine waves. can change individual cells by clicking in this window, or drag the to change whole groups of cells and see them update."
																}

															}
, 															{
																"box" : 																{
																	"fontname" : "Arial",
																	"fontsize" : 11.0,
																	"id" : "obj-6",
																	"linecount" : 2,
																	"maxclass" : "comment",
																	"numinlets" : 1,
																	"numoutlets" : 0,
																	"patching_rect" : [ 16.0, 104.0, 456.0, 31.0 ],
																	"text" : "Can adjust the complexity of harmonics the cells will look for, the rate of change, and many other parameters. click on the presets to hear a few examples."
																}

															}
, 															{
																"box" : 																{
																	"fontname" : "Arial",
																	"fontsize" : 11.0,
																	"id" : "obj-7",
																	"linecount" : 4,
																	"maxclass" : "comment",
																	"numinlets" : 1,
																	"numoutlets" : 0,
																	"patching_rect" : [ 16.0, 40.0, 496.0, 56.0 ],
																	"text" : "In this program there is a one-dimensional grid of 25 cells. the value of each cell is mapped to the frequency of a sine wave, so there 25 sine waves being controlled. each time the cells updated, the values change according to a simple rule, which causes them to move toward a harmonic of their left neighbor. eventually, the system will settle into stasis as every cell arrives at a valid harmonic."
																}

															}
, 															{
																"box" : 																{
																	"fontname" : "Arial",
																	"fontsize" : 11.0,
																	"id" : "obj-8",
																	"linecount" : 3,
																	"maxclass" : "comment",
																	"numinlets" : 1,
																	"numoutlets" : 0,
																	"patching_rect" : [ 16.0, 232.0, 465.0, 43.0 ],
																	"text" : "More cellular synthesis and filtering experiments underway. keep your eye on the delicate ear web site (http://www.sirius.com/~ear) for new developments. can already find \"lifefilter\" there (an audio filter controlled by john conway's \"life\" cellular automata)."
																}

															}
, 															{
